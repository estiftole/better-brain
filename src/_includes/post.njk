---
layout: base.njk
---
<article class="post">
    <header class="mainpost-header top-head">
        <h1 class="zero-margin">{{ title }}</h1>
        <div class="post-author">
            <time>{{ date | numericDate }}</time>
            <a>{{ author }}</a>
        </div>
    </header>

    <!-- New two-column layout wrapper -->
    <div class="post-layout" zero-margin>

        <!-- Sidebar Menu -->
        <aside class="post-sidebar">
            <nav class="toc" id="toc-nav" />
        </aside>

        <!-- Post Content -->
        <div class="post-body">
            {{ content | safe }}
        </div>

    </div>
</article>

<!-- Minimal JS to generate the menu -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const body = document.querySelector('.post-body');
        const toc = document.getElementById('toc-nav');

        // Select all H2 elements (this corresponds to '##' in Markdown)
        const headings = body.querySelectorAll('h2');

        // Hide the sidebar entirely if there are no H2 headings in the post
        if (headings.length === 0) {
            document.querySelector('.post-sidebar').style.display = 'none';
            return;
        }

        headings.forEach((heading) => {
            // 1. Generate an ID for the heading if Markdown didn't create one
            // E.g., "My Big Idea!" becomes "my-big-idea"
            const id = heading.id || heading.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
            heading.id = id;

            // 2. Create the anchor link
            const link = document.createElement('a');
            link.href = `#${id}`;
            link.textContent = heading.textContent;
            link.className = 'toc-link';

            // 3. Append to the menu
            toc.appendChild(link);
        });
    });
</script>
